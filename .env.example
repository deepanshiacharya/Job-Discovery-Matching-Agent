# ==========================================
# Database Configuration
# Default is PostgreSQL, fallback to SQLite if PostgreSQL is unreachable
# ==========================================
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/job_agent
SQLITE_FALLBACK=True
SQLITE_DB_PATH=./job_agent.db

# ==========================================
# LLM Configuration (OpenAI / Ollama / Mock)
# ==========================================
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# ==========================================
# Email Notification Configuration
# Provider: 'mock' (prints/logs to file) or 'smtp'
# ==========================================
EMAIL_PROVIDER=mock
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=jobagent@example.com
RECIPIENT_EMAIL=candidate@example.com

# ==========================================
# Application Directories & Pipeline Settings
# ==========================================
REPORT_DIR=./reports
DATA_DIR=./data
PROFILE_PATH=./config/candidate_profile.json
LOG_LEVEL=INFO
ENABLE_SEMANTIC_EMBEDDINGS=False
